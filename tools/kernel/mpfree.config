# MPFree's kernel settings for the MPC One, applied on top of the kernel's own
# multi_v7_defconfig (tools/kernel/build.sh). After the build,
# tools/kernel/check-config.py checks that every line below is in the final
# .config exactly as written: Kconfig silently drops or changes a setting whose
# dependencies are missing, and the build stops if it did.
#
# Own-kernel step 2 (docs/dev/hardware/own-kernel.md). Compared with Akai's
# 3.10.1 kernel on 2026-11-17 (blocks K1.1 and K1.2: its build settings and the
# driver bound to every device on the MPC One): every mainline driver Akai's
# kernel binds on this board is built in here too. Akai's own drivers (sound,
# panel, its touch driver, ac-power) are steps 3 and 4. Trimming is step 5.
# The built config was then compared with Akai's symbol by symbol (CI lists it:
# tools/kernel/config-digest.py); what stays different, and why, is in
# own-kernel.md ("Step 2: the built settings against Akai's").

# --- Name, and the config inside the kernel (the drivers survey reads it)
CONFIG_LOCALVERSION="-mpfree"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# GCC plugins are built by the machine's own C++ compiler and run inside the cross compiler,
# so the kernel would depend on the machine; without them it comes out the same everywhere.
# CONFIG_GCC_PLUGINS is not set

# --- Real time: the PREEMPT_RT patch, as Akai's 6.18.44-...-rt6
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_1000=y
# Akai's kernel adds isolcpus=2-3 to every command line; MPFree keeps cores 2
# and 3 for its audio (rust/mpfree-app/src/cores.rs). For the first power-ons
# our kernel also leaves on the regulators and clocks no driver of ours claims
# (the panel's and the sound card's, whose drivers are Akai's own), as Akai's
# kernel left them; step 5 takes these two words away.
CONFIG_CMDLINE="isolcpus=2-3 regulator_ignore_unused clk_ignore_unused"
CONFIG_CMDLINE_EXTEND=y
# As Akai's: the CPUs at full speed, and an oops is a panic (panic=10 restarts,
# and the chain's guard then starts MPFree on Akai's kernel once).
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_PANIC_ON_OOPS=y

# --- The CPU: the Cortex-A12/A17 errata fixes Akai's kernel has (multi_v7_defconfig
# leaves them off). The kernel applies each only to the core it names; 773022 is
# the Cortex-A15's and does nothing here, kept as Akai's has it.
CONFIG_ARM_ERRATA_773022=y
CONFIG_ARM_ERRATA_818325_852422=y
CONFIG_ARM_ERRATA_821420=y
CONFIG_ARM_ERRATA_825619=y
CONFIG_ARM_ERRATA_852421=y
CONFIG_ARM_ERRATA_852423=y
CONFIG_ARM_ERRATA_857271=y
CONFIG_ARM_ERRATA_857272=y

# --- The chain: the last kernel; LoadPin pins the stick's root, modules load from it
CONFIG_SECURITY=y
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_ENFORCE=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,bpf"
# CONFIG_KEXEC is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set

# --- Root filesystem on the USB stick, with no initramfs: built in
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2_DUAL_ROLE=y
# The USB-B port's gadget functions, built in as on Akai's, so its services
# find them in configfs without loading a module
CONFIG_USB_CONFIGFS=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
# Built in on Akai's, for whatever the stick's system mounts
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- What the stick's systemd needs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_UNIX=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_INPUT_EVDEV=y
# What Akai's own services on the stick use: GPIO lines in /sys/class/gpio,
# virtual and raw input devices, and LoadPin's trusted dm-verity digests
# (az0x-loadpin-trustpoints writes them at start; the file itself must come
# from the pinned root). Per-file encryption, as Akai's ext4 has it.
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_INIT=y
CONFIG_DM_UEVENT=y
CONFIG_SECURITY_LOADPIN_VERITY=y
CONFIG_FS_ENCRYPTION=y
# Turn a driver's debug messages on while it runs (dyndbg), for steps 3 and 4
CONFIG_DYNAMIC_DEBUG=y

# --- The eMMC and the SD card: modules that nothing loads at start
# (docs/dev/hardware/sd-card-and-internal-drive.md). check-config.py also
# refuses CONFIG_MMC=y on its own, whatever this file says.
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_DW=m
CONFIG_MMC_DW_ROCKCHIP=m
CONFIG_EXFAT_FS=m

# --- The board, as the drivers survey found it bound on Akai's kernel
# The power chips: an ACT8846 (most supplies, and the power-off), two Silergy
# SYR827/828 (the CPU's and the GPU's supply), the HYM8563 clock. Without
# these, every device that names one of their supplies waits for ever.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_I2C_RK3X=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_ACT8865=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HYM8563=y
# Restart as Akai's does: the gpio-restart line (PWR_OFF_DELAY) and the
# reboot mode in the PMU
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_GPIO_RESTART=y
CONFIG_SYSCON_REBOOT_MODE=y
# The SoC's own parts: power domains, the screen's IOMMU, I/O voltages, DMA,
# timer, PWM (the backlight), fuses, ADC, SRAM
CONFIG_PM=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_NVMEM=y
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_SRAM=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
# Heat, CPU speed, the watchdog Akai's system may have left running, the
# power key and the two red lights
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y
# Governors Akai's system may pick from user space
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
# The SoC's crypto engine: Akai's kernel leaves it alone, and so does ours
# (multi_v7_defconfig makes its driver a module, which udev would load).
# CONFIG_CRYPTO_DEV_ROCKCHIP is not set

# --- Ethernet (works on the stick's device tree since step 7)
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y
CONFIG_CFG80211=m
# Multicast, as on Akai's: Ableton Link and mDNS find other machines with it
CONFIG_IP_MULTICAST=y

# --- Screen, touch, GPU, backlight. The panel (urt,umo-p076md-t) has a driver
# of Akai's own, not in mainline, so there is no picture until step 4. The
# running unit's touch chip (ILI2117 at 4-0026) is in mainline's ili210x; the
# image's board file names an ILI2116 at 0x41 instead, so step 4 checks which
# one our device tree carries.
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=300
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_ILI210X=y
# The 2D engine (RGA), a module as on Akai's
CONFIG_VIDEO_ROCKCHIP_RGA=m

# --- Sound and MIDI: the controller's USB audio and MIDI now; the I2S DAC and ADC in step 3
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_SOC=y
# (6.18 has no CONFIG_SND_SOC_ROCKCHIP: the Rockchip sound drivers are a menu of their own)
CONFIG_SND_SOC_ROCKCHIP_I2S=y

# --- What a musician plugs in, as Akai's kernel takes it (modules, loaded when
# the device appears): drives formatted on a Mac, discs, Windows' compressed
# NTFS files, more FAT code pages; keyboards, mice, game and touch controllers;
# USB serial and modem-class (ACM) devices, which some MIDI gear is. No network
# adapters or modems: the MPC One has its Ethernet.
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_UDF_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NLS_ASCII=m
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_CODEPAGE_852=m
CONFIG_NLS_ISO8859_15=m
CONFIG_HID_APPLE=m
CONFIG_HID_ELECOM=m
CONFIG_HID_GFRM=m
CONFIG_HID_ICADE=m
CONFIG_HID_LENOVO=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_SONY=m
CONFIG_HID_TIVO=m
CONFIG_HID_WIIMOTE=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
# usbmon, to watch the controller's USB MIDI while bringing the kernel up
CONFIG_USB_MON=m
