# The kernel, PREEMPT_RT patch and compiler MPFree builds with (tools/kernel/build.sh), read as
# shell variables. With LINUX_VERSION empty, build.sh takes the newest 6.18 RT patch on kernel.org
# and the matching kernel; with GCC_VERSION empty, the newest gcc 14 of kernel.org's crosstool
# compilers. It checks each against kernel.org's PGP signatures, builds, and prints the lines to pin
# here. Once pinned, a build takes exactly these files and checks their sha256.
# Pinned 2026-11-17 from CI run 44013997120 (PR #442): the kernel signed by Greg Kroah-Hartman
# (647F28654894E3BD457199BE38DBBDC86092693E), the RT patch by Sebastian Andrzej Siewior
# (64254695FFF0AA4466CC19E67B96E8162A8CF5D1), the compiler by Arnd Bergmann
# (88AFCD206B1611957187F16B60AB47FFC9095227); the build made 6.18.57-rt9-mpfree.
LINUX_SERIES=6.18
LINUX_VERSION=6.18.57
RT_PATCH=patch-6.18.57-rt9.patch.xz
LINUX_TAR_SHA256=5bd9acdc82ec5efc3790ae840e5aaa40dfde7efff261cf6dde902dc570acf98c
RT_PATCH_SHA256=0109b74525de6ef5960f49dd4635a406dc4cc8c4f993d0b34c689cb5fd690233
GCC_SERIES=14
GCC_VERSION=14.4.0
GCC_TAR_SHA256=5563e5fcdcd0f95be8bd2fc1d9238b5dfcc42d78147777ac61361d2125b1e82f
