# The kernel and PREEMPT_RT patch MPFree builds (tools/kernel/build.sh), read as shell variables.
# With LINUX_VERSION empty, build.sh takes the newest 6.18 RT patch on kernel.org and the
# matching kernel, checks both against kernel.org's PGP signatures, builds, and prints the
# lines to pin here. Once pinned, a build takes exactly these files and checks their sha256.
LINUX_SERIES=6.18
LINUX_VERSION=
RT_PATCH=
LINUX_TAR_SHA256=
RT_PATCH_SHA256=
