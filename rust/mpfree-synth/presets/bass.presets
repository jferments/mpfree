mpfree-preset = 2
engine = mpfree.bass
name = Amp Bass
fx.1 = mpfree.fx.amp
macro.1 = Cutoff
macro.1.map = filter.cutoff 100 3000
macro.2 = Env amount
macro.2.map = filter.env-amount 0 100
macro.3 = Drive
macro.3.map = fx-1.gain 1 9
macro.3.map = output.drive 0 60
macro.4 = Glide
macro.4.map = play.glide 0 300

# Macros
macros.cutoff = 50
macros.env-amount = 50
macros.drive = 20
macros.glide = 20

# Filter
filter.cutoff = 548
filter.resonance = 25
filter.env-amount = 50
filter.filter-decay = 250

# Amp
amp.decay = 800
amp.sustain = 70
amp.vel-tone = 80

# Play
play.glide = 60

# Output
output.drive = 12

# FX 1: a crunchy amp into a bass cabinet
fx-1.model = Crunch
fx-1.gain = 2.6
fx-1.bass = 7
fx-1.mid = 6
fx-1.treble = 4
fx-1.cab = 1x15 bass
fx-1.depth = 7
fx-1.level = -5

mpfree-preset = 2
engine = mpfree.bass
name = Tube 808
fx.1 = mpfree.fx.drive
macro.1 = Drop
macro.1.map = pitch.drop 0 24
macro.2 = Decay
macro.2.map = amp.release 50 3000
macro.3 = Drive
macro.3.map = fx-1.drive 0 24
macro.3.map = output.drive 30 90
macro.4 = Tone
macro.4.map = output.tone 1000 12000

# Macros
macros.drop = 50
macros.decay = 44
macros.drive = 50
macros.tone = 56

