mpfree-preset = 1
engine = mpfree.keys
name = Phase Tines
fx.1 = mpfree.fx.phaser
fx.2 = mpfree.fx.plate
macro.1 = Tone
macro.1.map = tone.tone -50 50
macro.1.map = tone.hardness 35 85
macro.2 = Bark
macro.2.map = tone.bark 10 90
macro.3 = Tremolo
macro.3.map = amp.tremolo 0 80
macro.4 = Effects
macro.4.map = fx-1.mix 0 60
macro.4.map = fx-2.mix 5 40

# Macros
macros.tone = 60
macros.bark = 60
macros.tremolo = 0
macros.effects = 60

# Tone
tone.hardness = 65
tone.bell = 50
tone.bark = 58
tone.tone = 10

# Amp
amp.trem-rate = 5

# FX 1: a slow phaser
fx-1.rate = 0.35
fx-1.depth = 60
fx-1.feedback = 15
fx-1.mix = 36

# FX 2: a short plate
fx-2.pre-delay = 15
fx-2.decay = 1800
fx-2.low-cut = 150
fx-2.mix = 26

mpfree-preset = 1
engine = mpfree.keys
name = Wah Clav
fx.1 = mpfree.fx.autowah
fx.2 = mpfree.fx.delay
macro.1 = Tone
macro.1.map = tone.tone -50 50
macro.2 = Wah
macro.2.map = fx-1.mix 0 75
macro.2.map = fx-1.resonance 30 60
macro.3 = Mute
macro.3.map = clav.mute 0 70
macro.4 = Effects
macro.4.map = fx-2.mix 0 35

# Macros
macros.tone = 50
macros.wah = 80
macros.mute = 0
macros.effects = 40

# Model
model.model = Clav
model.decay = 3000
model.release = 40

# Tone
tone.hardness = 70
tone.bark = 60

# Clav
clav.pickup = Bridge
clav.clav-tone = Treble

# FX 1: an envelope wah
fx-1.sensitivity = 60
fx-1.attack = 4
fx-1.release = 120
fx-1.center = 55
fx-1.low = 300
fx-1.high = 5000
fx-1.resonance = 54
fx-1.mix = 60

# FX 2: a dotted-eighth echo
fx-2.feedback = 25
fx-2.tone = 4500
fx-2.mix = 14

# Output
output.level = -3.5
