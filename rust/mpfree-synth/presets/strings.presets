mpfree-preset = 1
engine = mpfree.strings
name = Hall Strings
fx.1 = mpfree.fx.room
macro.1 = Crescendo
macro.1.map = swell.crescendo 20 3000
macro.2 = Sustain
macro.2.map = swell.sustain 300 6000
macro.3 = Ensemble
macro.3.map = ensemble.depth 20 180
macro.3.map = ensemble.width 60 100
macro.4 = Brightness
macro.4.map = tone.brightness 15 85
macro.5 = Space
macro.5.map = fx-1.mix 0 50

