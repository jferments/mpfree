# The built-in default theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = default' line.
name          = Default
bg            = #0B0D12
surface       = #151922
raised        = #222838
outline       = #2B3245
text          = #E9ECF2
text_dim      = #98A1B3
text_faint    = #5F687B
accent        = #6EA8FE
accent2       = #D46CFF
on_accent     = #0B0D12
good          = #3DDC97
warn          = #FFC145
bad           = #FF5C5C
track         = #6EA8FE #3DDC97 #FFC145 #D46CFF #FF7A59 #4DD8E8 #F26BA8 #A3E05B
radius        = 14
gap           = 12
pad           = 14
size_brand    = 28
size_title    = 19
size_body     = 17
size_small    = 14
size_mono     = 14
corners       = round
glow          = 0
tint          = 0
text_glow     = 0
backdrop      = solid
backdrop_to   = #1B2340
backdrop_line = #151922
backdrop_step = 40
face_body     = sans
face_title    = bold
startup       = synthwave
mode          = auto
record        = #FF4D5E
qlink.1       = {track.1}
qlink.2       = {track.2}
qlink.3       = {track.3}
qlink.4       = {track.4}
text_inverse  = {bg}
highlight     = #FFFFFF
shadow        = #000000
series.1      = #6EA8FE
series.2      = #3DDC97
series.3      = #FFC145
series.4      = #D46CFF
series.5      = #FF8A65
series.6      = #4FC3C9
series.7      = #F06292
series.8      = #AED581
