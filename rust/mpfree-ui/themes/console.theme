# The built-in console theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = console' line.
name          = Console
bg            = #020803
surface       = #061409EB
raised        = #0C2A14
outline       = #1A5C2C
text          = #9CFFB0
text_dim      = #3FC066
text_faint    = #217A3C
accent        = #39FF6A
accent2       = #B8FF3C
on_accent     = #021006
good          = #39FF6A
warn          = #E8FF3C
bad           = #FF4D4D
track         = #39FF6A #B8FF3C #3CFFD8 #8CFF9E #E8FF3C #2BD9A0 #6CFF3C #C6FFD2
radius        = 4
gap           = 10
pad           = 12
size_brand    = 26
size_title    = 17
size_body     = 16
size_small    = 13
size_mono     = 14
corners       = chamfer
glow          = 150
tint          = 170
text_glow     = 150
backdrop      = scanlines
backdrop_to   = #031208
backdrop_line = #000000
backdrop_step = 3
face_body     = sans
face_title    = bold
startup       = console
mode          = auto
record        = #FF4D5E
qlink.1       = #6EA8FE
qlink.2       = #3DDC97
qlink.3       = #FFC145
qlink.4       = #D46CFF
text_inverse  = {bg}
highlight     = #FFFFFF
shadow        = #000000
series.1      = #6EA8FE
series.2      = #3DDC97
series.3      = #FFC145
series.4      = #D46CFF
series.5      = #FF8A65
series.6      = #4FC3C9
series.7      = #F06292
series.8      = #AED581
