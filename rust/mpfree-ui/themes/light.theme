# The built-in light theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = light' line.
name          = Light
bg            = #E4E7EB
surface       = #F4F5F7
raised        = #DCE1E8
outline       = #BFC6D1
text          = #161A21
text_dim      = #474F5E
text_faint    = #5E6777
accent        = #2A63D4
accent2       = #8B3CC6
on_accent     = #FFFFFF
good          = #17784C
warn          = #965700
bad           = #C42B2B
track         = #2A63D4 #17784C #A96700 #8B45D0 #C24E22 #0D7A8A #BC3374 #56820F
radius        = 14
corners       = round
glow          = 0
tint          = 0
text_glow     = 0
backdrop      = solid
backdrop_to   = #D3D8E0
backdrop_line = #F4F5F7
backdrop_step = 40
startup       = synthwave
mode          = light
record        = {bad}
qlink.1       = {track.1}
qlink.2       = {track.2}
qlink.3       = {track.3}
qlink.4       = {track.4}
text_inverse  = light_dark({surface}, {bg})
highlight     = {text}
shadow        = light_dark({text}, {bg})
series.1      = {track.1}
series.2      = {track.2}
series.3      = {track.3}
series.4      = {track.4}
series.5      = {track.5}
series.6      = {track.6}
series.7      = {track.7}
series.8      = {track.8}
handle        = light_dark({surface}, {text})
picked        = {accent}
on_picked     = {on_accent}
cut           = {text_dim}
grain         = {accent2}
