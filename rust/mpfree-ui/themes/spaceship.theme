# The built-in spaceship theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = spaceship' line.
name          = Spaceship
bg            = #07060C
surface       = #110E1CF0
raised        = #2A1F4A
outline       = #3D2F6B
text          = #F2EEFF
text_dim      = #A99CD6
text_faint    = #5E5385
accent        = #A78BFA
accent2       = #FFFFFF
on_accent     = #07060C
good          = #8BE9C8
warn          = #F5C97A
bad           = #FF6B8B
track         = #A78BFA #FFFFFF #7C5CFF #D4C6FF #5B8CFF #E58BFA #8BE9C8 #C0B5E8
radius        = 10
corners       = chamfer
glow          = 90
tint          = 110
text_glow     = 0
backdrop      = dots
backdrop_to   = #0E0A1C
backdrop_line = #2E2552
backdrop_step = 24
startup       = spaceship
mode          = auto
record        = #FF4D5E
qlink.1       = #6EA8FE
qlink.2       = #3DDC97
qlink.3       = #FFC145
qlink.4       = #D46CFF
text_inverse  = light_dark({surface}, {bg})
highlight     = #FFFFFF
shadow        = #000000
series.1      = #6EA8FE
series.2      = #3DDC97
series.3      = #FFC145
series.4      = #D46CFF
series.5      = #FF8A65
series.6      = #4FC3C9
series.7      = #F06292
series.8      = #AED581
handle        = #FFFFFF
picked        = {accent}
on_picked     = {on_accent}
cut           = #B8C2D6
grain         = #C77DFF
