# The built-in slate theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = slate' line.
name          = Slate
bg            = #313B47
surface       = #3A4655
raised        = #4B5B6C
outline       = #5C6E82
text          = #EEF2F7
text_dim      = #C9D3E0
text_faint    = #9DB0C6
accent        = #4FD1C5
accent2       = #B9A4FF
on_accent     = #10181F
good          = #9EEB95
warn          = #F2C14E
bad           = #FF8A80
track         = #6FA8FF #6BD49A #F2C14E #B9A4FF #FF9A6B #4FD1C5 #F58BC0 #B5DB6B
radius        = 14
corners       = round
glow          = 0
tint          = 0
text_glow     = 0
backdrop      = solid
backdrop_to   = #3A4655
backdrop_line = #3A4655
backdrop_step = 40
startup       = synthwave
mode          = dark
record        = {bad}
qlink.1       = {track.1}
qlink.2       = {track.2}
qlink.3       = {track.3}
qlink.4       = {track.4}
text_inverse  = light_dark({surface}, {bg})
highlight     = {text}
shadow        = #000000
series.1      = {track.1}
series.2      = {track.2}
series.3      = {track.3}
series.4      = {track.4}
series.5      = {track.5}
series.6      = {track.6}
series.7      = {track.7}
series.8      = {track.8}
handle        = light_dark({surface}, {text})
cut           = {text_dim}
grain         = {accent2}
