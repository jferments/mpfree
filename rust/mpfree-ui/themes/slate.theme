# The built-in slate theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = slate' line.
name          = Slate
bg            = #6D8196
surface       = #8FA8C1
raised        = #C2CDDC
outline       = #4B5B6C
text          = #070A0E
text_dim      = #1B232D
text_faint    = #2B3746
accent        = #0F2F57
accent2       = #5B2A86
on_accent     = #FFFFFF
good          = #0B4F2C
warn          = #5C3A00
bad           = #7A1414
track         = #17437A #12512F #5A3B00 #4E2A85 #7E2F14 #08505C #7A2350 #314A08
radius        = 14
corners       = round
glow          = 0
tint          = 0
text_glow     = 0
backdrop      = solid
backdrop_to   = #8FA8C1
backdrop_line = #8FA8C1
backdrop_step = 40
startup       = synthwave
mode          = light
record        = {bad}
qlink.1       = {track.1}
qlink.2       = {track.2}
qlink.3       = {track.3}
qlink.4       = {track.4}
text_inverse  = #F4F7FA
highlight     = {text}
shadow        = light_dark({text}, {bg})
series.1      = {track.1}
series.2      = {track.2}
series.3      = {track.3}
series.4      = {track.4}
series.5      = {track.5}
series.6      = {track.6}
series.7      = {track.7}
series.8      = {track.8}
handle        = light_dark({surface}, {text})
cut           = {text_dim}
grain         = {accent2}
