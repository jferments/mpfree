# The built-in abletown theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = abletown' line.
name          = AbleTown
bg            = #8F8F8F
surface       = #A5A5A5
raised        = #C2C2C2
outline       = #6E6E6E
text          = #0E0E0E
text_dim      = #2A2A2A
text_faint    = #3A3A3A
accent        = #1E1E1E
accent2       = #FFAD19
on_accent     = #FFFFFF
good          = #1A5501
warn          = #5E3600
bad           = #AB0000
track         = #FF9F1A #FFF034 #25FFA8 #18E9FF #8BC5FF #D86CE4 #FF94A6 #BAD074
radius        = 4
corners       = round
glow          = 0
tint          = 0
text_glow     = 0
backdrop      = solid
backdrop_to   = #A5A5A5
backdrop_line = #A5A5A5
backdrop_step = 40
startup       = synthwave
mode          = light
record        = {bad}
qlink.1       = #7B4700
qlink.2       = #5A5400
qlink.3       = #006039
qlink.4       = #005D67
text_inverse  = #F2F2F2
highlight     = #FFFFFF
shadow        = light_dark({text}, {bg})
series.1      = #7B4700
series.2      = #5A5400
series.3      = #006039
series.4      = #005D67
series.5      = #0052A4
series.6      = #8E1C9B
series.7      = #AD001D
series.8      = #4B5A1E
handle        = #E6E6E6
picked        = #FFAD19
on_picked     = #0E0E0E
cut           = {text_dim}
grain         = {accent2}
