# The built-in synthwave theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = synthwave' line.
name          = Synthwave
bg            = #12052A
surface       = #1E0B3DE1
raised        = #3A1466
outline       = #FF2E97AA
text          = #FCE7FF
text_dim      = #C39BE0
text_faint    = #7E5AA6
accent        = #FF2E97
accent2       = #2DE2E6
on_accent     = #12052A
good          = #2DE2E6
warn          = #FFB443
bad           = #FF3864
track         = #FF2E97 #2DE2E6 #FFB443 #B967FF #F9F871 #FF6C11 #01CDFE #FF71CE
radius        = 10
gap           = 12
pad           = 14
size_brand    = 28
size_title    = 19
size_body     = 17
