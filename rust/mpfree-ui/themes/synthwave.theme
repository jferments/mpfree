# The built-in synthwave theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = synthwave' line.
name          = Synthwave
bg            = #10042A
surface       = #241048E6
raised        = #351363
outline       = #6B3FA0
text          = #FCE7FF
text_dim      = #C9A6E8
text_faint    = #9D7CC6
accent        = #FF2E97
accent2       = #2DE2E6
on_accent     = #12052A
good          = #50FFB1
warn          = #FFB443
bad           = #FF4D3D
track         = #FF2E97 #2DE2E6 #FFB443 #B967FF #F9F871 #FF6C11 #01CDFE #FF71CE
radius        = 10
corners       = round
glow          = 170
tint          = 70
text_glow     = 0
backdrop      = grid
backdrop_to   = #2B0B4A
backdrop_line = #FF2E9733
backdrop_step = 40
startup       = synthwave
mode          = auto
record        = {bad}
qlink.1       = {track.1}
qlink.2       = {track.2}
qlink.3       = {track.3}
qlink.4       = {track.4}
text_inverse  = light_dark({surface}, {bg})
highlight     = #FFFFFF
shadow        = #000000
series.1      = {track.1}
series.2      = {track.2}
series.3      = {track.3}
series.4      = {track.4}
series.5      = {track.5}
series.6      = {track.6}
series.7      = {track.7}
series.8      = {track.8}
handle        = #FFFFFF
cut           = {text_dim}
grain         = #B967FF
