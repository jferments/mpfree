# The built-in synthwave theme, every key written out. Copy it, change what you
# like, and keep only the lines you changed after a 'base = synthwave' line.
name          = Synthwave
bg            = #12052A
surface       = #1E0B3DE1
raised        = #3A1466
outline       = #FF2E97AA
text          = #FCE7FF
text_dim      = #C39BE0
text_faint    = #7E5AA6
accent        = #FF2E97
accent2       = #2DE2E6
on_accent     = #12052A
good          = #2DE2E6
warn          = #FFB443
bad           = #FF3864
track         = #FF2E97 #2DE2E6 #FFB443 #B967FF #F9F871 #FF6C11 #01CDFE #FF71CE
radius        = 10
gap           = 12
pad           = 14
size_brand    = 28
size_title    = 19
size_body     = 17
size_small    = 14
size_mono     = 14
corners       = round
glow          = 190
tint          = 70
text_glow     = 0
backdrop      = grid
backdrop_to   = #2B0B4A
backdrop_line = #FF2E972E
backdrop_step = 40
face_body     = sans
face_title    = bold
startup       = synthwave
mode          = auto
record        = #FF4D5E
qlink.1       = #6EA8FE
qlink.2       = #3DDC97
qlink.3       = #FFC145
qlink.4       = #D46CFF
text_inverse  = {bg}
highlight     = #FFFFFF
shadow        = #000000
series.1      = #6EA8FE
series.2      = #3DDC97
series.3      = #FFC145
series.4      = #D46CFF
series.5      = #FF8A65
series.6      = #4FC3C9
series.7      = #F06292
series.8      = #AED581
handle        = #FFFFFF
cut           = #B8C2D6
grain         = #C77DFF
